# tailscaled joins this instance to the tailnet (TSE-690 phase 3). Static Go
# binaries copied out of the official image rather than installed from a repo:
# they are self-contained, and this keeps the tailscale version pinned in one
# place instead of drifting with Debian's package index.
ARG TAILSCALE_VERSION=v1.90.6
FROM tailscale/tailscale:${TAILSCALE_VERSION} AS tailscale

FROM node:22.20-bookworm-slim AS builder
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3-pip \
    bash \
    nginx \
&& rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx


RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app

COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

RUN pnpm install
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

CMD ["sh", "-c", "nginx && pnpm run pm2"]

# Unikraft initrd is a flat rootfs with a ~4GiB load ceiling: drop the build
# toolchain and caches after the pnpm build so the image fits.
RUN apt-get purge -y g++ make python3-pip \
 && apt-get autoremove -y \
 && rm -rf /root/.local/share/pnpm /root/.cache /app/.nx /var/lib/apt/lists/*

# node_modules ships as a ROM (read-only image mounted at /app/node_modules);
# the initrd must stay small because it loads into guest RAM.
RUN rm -rf /app/node_modules && mkdir /app/node_modules

# socat is the loopback forwarder for every backend leg. Today it tunnels
# plaintext gRPC (h2c) out to temporal's TLS service, because the LB terminates
# TLS but offers no h2 ALPN, which the temporal SDK client insists on. Since
# TSE-690's port-closure extension it also carries the Postgres, Redis and
# Temporal legs over the tailnet instead — see the wrapper for the switch.
#
# curl and ca-certificates are for the wrapper's health poll and for tailscaled's
# TLS to the control plane. node:22-bookworm-slim purges curl after installing
# node, so it is genuinely absent without this line.
RUN apt-get update && apt-get install -y --no-install-recommends socat curl ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=tailscale /usr/local/bin/tailscaled /usr/local/bin/tailscaled
COPY --from=tailscale /usr/local/bin/tailscale /usr/local/bin/tailscale

# Launcher lives here, not in the build context: editing it must not invalidate
# the COPY layer above, which would cost a full pnpm install + build every time
# the wrapper is touched. ROM with node_modules attaches as /dev/ukp_rom1.
#
# It is PID 1 and it supervises three things now:
#
#   tailscaled  userspace networking, state on the volume at $TS_STATE_DIR.
#               This is how the-newsroom reaches the public API since TSE-690
#               phase 3, instead of over the internet through Cloudflare Access.
#   forwarders  one loopback listener per backend leg: Postgres, Redis and
#               Temporal. Each is independently switchable between the public
#               FQDN and the tailnet, which is what lets the data tier be cut
#               over one backend at a time instead of all three at once.
#   the app     nginx on 5000 in front of pm2 (frontend 4200, backend 3000,
#               orchestrator). Still the foreground process, so the instance's
#               restart policy still means what it used to: if the app dies,
#               PID 1 dies and the platform restarts the instance.
#
# WHY THE FORWARDERS DRIVE `tailscale nc` RATHER THAN A SOCKS5 ADDRESS.
# Outbound does not just work in userspace mode: the netstack auto-forwards
# INBOUND tailnet TCP to loopback, but the host has no route to 100.64.0.0/10.
# tailscaled runs a SOCKS5 proxy on request (--socks5-server, passed below) and
# the estate's plan was socat through it — except socat 1.7.4.4, what Debian
# bookworm ships, has WITH_SOCKS4 and WITH_SOCKS4A compiled in and NO SOCKS5 at
# all (checked with `socat -V`; SOCKS5 arrived in socat 1.8.0). tailscaled
# speaks only SOCKS5. `tailscale nc <host> <port>` pipes a tailnet connection to
# stdin/stdout through the daemon we already run, so socat's EXEC address gets
# us there with nothing added to the image. Cost: one short-lived process per
# connection, fine for pooled clients (Prisma, ioredis, one gRPC channel).
#
# TS_TUN=tailscale0 would delete all three forwarders: a real TUN device gives
# the kernel a route to 100.x and every client dials tailnet names unmodified.
#
# MEASURED 2026-08-31 on postiz-temporal, and it is NOT a drop-in win. The TUN
# device does come up and outbound works — temporal read its Postgres over a
# 100.x address with no forwarder. But temporal's own gRPC frontend then never
# bound 7233 (the platform's service list for the instance dropped to
# `udp:36093`), which took the whole postiz backend down with it, because the
# backend refuses to start without Temporal. Reverting to userspace-networking
# restored it immediately.
#
# There is a second, sharper edge, and it will bite anything that keeps a
# loopback forwarder: WITH TUN THE NODE GAINS IPv6, AND `localhost` STARTS
# RESOLVING TO ::1 FIRST. Every listener bound to 127.0.0.1 — socat here, and
# nginx's upstreams — becomes unreachable by name. The symptom is
# `connect ECONNREFUSED ::1:7233`. Pin such clients to 127.0.0.1 explicitly.
#
# So TUN stays off by default and the forwarders below are the supported path.
#
# tailscaled is deliberately NOT allowed to be the reason postiz fails to boot.
# A spent or malformed auth key logs and moves on; the dashboard, the scheduler
# and the public path through Cloudflare all work without a tailnet.
RUN cat > /ukc-launch.sh <<'LAUNCH'
#!/bin/sh
set -eu

log() { echo "[wrapper] $*"; }

TS_STATE_DIR="${TS_STATE_DIR:-/var/lib/tailscale}"
TS_SOCKET="${TS_STATE_DIR}/tailscaled.sock"
TS_HOSTNAME="${TS_HOSTNAME:-postiz}"
# An OAuth-client-secret auth key registers with no tags of its own, so the node
# has to advertise the tag itself. A pre-tagged tskey-auth-... key is the
# opposite case and rejects the flag, so set TS_TAGS empty for one of those.
TS_TAGS="${TS_TAGS-tag:postiz}"
TS_SOCKS5_PORT="${TS_SOCKS5_PORT:-1055}"
# userspace-networking (default) or tailscale0 for a real TUN device.
#
# MEASURED 2026-08-31 on postiz-temporal in sfo: tailscale0 works. The interface
# comes up with its tailnet address and an ordinary client in the instance dials
# a tailnet peer unmodified - temporal reached postiz-db at its 100.x address
# with no forwarder and no SOCKS5. One health warning is expected and harmless:
# `router: create table: ... socket: protocol not supported`, netlink route-table
# enumeration failing on this trimmed kernel, which does not stop the interface
# working.
#
# That is what lets DATABASE_URL, REDIS_URL and TEMPORAL_ADDRESS name tailnet
# addresses directly. The forwarders below stay as the documented fallback for
# userspace mode; with TUN none of them is set.
TS_TUN="${TS_TUN:-userspace-networking}"
# The legacy socat TLS tunnel to temporal's PUBLIC service. Set it EMPTY to turn
# the tunnel off - which is what a tailnet TEMPORAL_ADDRESS wants, since the
# tunnel would otherwise sit on 7233 and shadow it. Note `-` not `:-`, so an
# explicit empty value is honoured.
TEMPORAL_TLS_TARGET="${TEMPORAL_TLS_TARGET-postiz-temporal.sfo.unikraft.app:7233}"
# Tailnet peer names for the three backend legs. EMPTY means "leave this leg on
# the public FQDN", which is the state before the cutover and the state to
# revert to if one leg misbehaves. Setting one moves that leg and nothing else.
#
# Each also decides how its client must be configured, and getting it wrong
# fails closed at connect time rather than degrading quietly:
#
#   PG_FORWARD_TO       DATABASE_URL host becomes 127.0.0.1 and sslmode MUST
#                       become `disable`. postiz-db has no TLS compiled in; the
#                       public FQDN only appears to offer it because the load
#                       balancer terminates. `require` over the forwarder gets
#                       "server does not support SSL, but SSL was required".
#   REDIS_FORWARD_TO    REDIS_URL becomes `redis://` (NOT `rediss://`) on
#                       127.0.0.1, for exactly the same reason — and the SNI
#                       workaround this stack needed for the public leg stops
#                       applying, because there is no TLS to name a server for.
#   TEMPORAL_FORWARD_TO replaces the socat TLS tunnel rather than joining it:
#                       both would bind 7233. TEMPORAL_ADDRESS stays
#                       localhost:7233 either way, which is why this leg is the
#                       one that changes nothing on the client side and can go
#                       last.
PG_FORWARD_TO="${PG_FORWARD_TO:-}"
PG_FORWARD_PORT="${PG_FORWARD_PORT:-5432}"
REDIS_FORWARD_TO="${REDIS_FORWARD_TO:-}"
REDIS_FORWARD_PORT="${REDIS_FORWARD_PORT:-6379}"
TEMPORAL_FORWARD_TO="${TEMPORAL_FORWARD_TO:-}"
TEMPORAL_FORWARD_PORT="${TEMPORAL_FORWARD_PORT:-7233}"
# 401 is the healthy answer: it proves the backend is up and the public API guard
# is running. A 200 would need a credential.
#
# IT POINTS AT THE BACKEND ON 3000, NOT AT NGINX ON 5000, AND THAT MATTERS MORE
# THAN IT LOOKS. Polling nginx while the backend is still starting makes nginx
# log two "connect() failed ... upstream" lines PER ATTEMPT. At one attempt every
# two seconds for five minutes that is ~300 lines, and the platform's log API
# returns only the last ~5KB — so the health poll reliably evicts the boot output
# of the thing it is waiting for. That cost real time on 2026-08-31: the backend
# was failing with a clear error and the error had already scrolled away every
# time it was looked for. Polling 3000 directly fails with connection-refused,
# which nginx never sees and never logs.
HEALTH_URL="${HEALTH_URL:-http://127.0.0.1:3000/public/v1/integrations}"
LOCAL_DEV="${LOCAL_DEV:-0}"

# --- node_modules -----------------------------------------------------------
# It ships as a ROM because the initrd loads into guest RAM and 3.1 GiB of
# modules does not fit under the ceiling.
if [ "${LOCAL_DEV}" != '1' ]; then
	mount -t erofs -o ro /dev/ukp_rom1 /app/node_modules
fi

# --- backend legs -----------------------------------------------------------
# One loopback listener per backend. `tailnet_forward` is the tailnet version;
# the temporal TLS tunnel is the public-FQDN version, and they are mutually
# exclusive on port 7233.
tailnet_forward() {
	_name="$1"; _peer="$2"; _port="$3"
	socat "TCP-LISTEN:${_port},bind=127.0.0.1,fork,reuseaddr" \
		"EXEC:/usr/local/bin/tailscale --socket=${TS_SOCKET} nc ${_peer} ${_port}" &
	log "${_name} forwarder 127.0.0.1:${_port} -> ${_peer}:${_port} over the tailnet"
}

if [ -n "${PG_FORWARD_TO}" ]; then
	tailnet_forward postgres "${PG_FORWARD_TO}" "${PG_FORWARD_PORT}"
fi
if [ -n "${REDIS_FORWARD_TO}" ]; then
	tailnet_forward redis "${REDIS_FORWARD_TO}" "${REDIS_FORWARD_PORT}"
fi
if [ -n "${TEMPORAL_FORWARD_TO}" ]; then
	tailnet_forward temporal "${TEMPORAL_FORWARD_TO}" "${TEMPORAL_FORWARD_PORT}"
elif [ -n "${TEMPORAL_TLS_TARGET}" ]; then
	socat TCP-LISTEN:7233,bind=127.0.0.1,fork,reuseaddr "OPENSSL:${TEMPORAL_TLS_TARGET},verify=0" &
	log "socat temporal TLS tunnel -> ${TEMPORAL_TLS_TARGET} (public FQDN)"
else
	log 'no temporal tunnel: TEMPORAL_ADDRESS names a reachable host directly'
fi

# --- tailscale --------------------------------------------------------------
# Userspace networking: no TUN device needed, and the netstack auto-forwards
# inbound tailnet TCP to 127.0.0.1 on the same port. So nginx on 5000 is
# reachable at <node>.<tailnet>.ts.net:5000 with no `tailscale serve` and no
# proxy in front of it.
#
# --socks5-server is what an OUTBOUND tailnet call would need; the host has no
# route to 100.64.0.0/10 of its own. postiz makes none today (it is a callee,
# and it has no outbound grant in policy.hujson), so the proxy is unused. If one
# is ever needed, extend the socat line above rather than adding a second
# forwarder: socat can dial through a SOCKS5 proxy.
join_tailnet() {
	i=0
	while [ "$i" -lt 30 ]; do
		if /usr/local/bin/tailscale --socket="${TS_SOCKET}" status >/dev/null 2>&1; then break; fi
		i=$((i + 1))
		sleep 1
	done

	set -- --authkey="${TS_AUTHKEY:-}" --hostname="${TS_HOSTNAME}" \
		--accept-dns=false --accept-routes=false
	if [ -n "${TS_TAGS:-}" ]; then
		set -- "$@" --advertise-tags="${TS_TAGS}"
	fi

	attempt=1
	backoff=3
	while [ "$attempt" -le 4 ]; do
		log "tailscale up attempt ${attempt}/4"
		# Bounded by `timeout`: an unwrapped `tailscale up` against a bad key
		# retries internally instead of returning, which wedges boot with no
		# diagnostics (measured on fra, 2026-08-28, TSE-690 phase 2a).
		if timeout 20s /usr/local/bin/tailscale --socket="${TS_SOCKET}" up "$@" 2>&1; then
			log 'tailnet joined'
			_ip=$(timeout 10s /usr/local/bin/tailscale --socket="${TS_SOCKET}" ip -4 2>/dev/null | head -1 || true)
			log "tailnet ip ${_ip:-unknown}"
			return 0
		fi
		log "tailscale up attempt ${attempt}/4 failed"
		attempt=$((attempt + 1))
		if [ "$attempt" -le 4 ]; then
			sleep "$backoff"
		fi
		backoff=$((backoff * 2))
	done
	log 'tailscale up did not succeed after all attempts; the daemon stays up and retries on its own'
	return 0
}

# Restart the daemon if it dies. The tailnet is the only path the-newsroom has
# to the public API, so losing it silently until the next instance restart is
# not acceptable; five exits in a minute is a crash loop, so stop hammering.
run_tailscaled() {
	# HOME only for this subshell: tailscaled writes a log-policy file under
	# $HOME/.cache and the rest of the stack must not have its HOME moved.
	export HOME="${TS_STATE_DIR}"
	mkdir -p "${TS_STATE_DIR}"
	failures=0
	window_start=$(date +%s)
	while :; do
		/usr/local/bin/tailscaled \
			--tun="${TS_TUN}" \
			--statedir="${TS_STATE_DIR}" \
			--socket="${TS_SOCKET}" \
			--socks5-server="127.0.0.1:${TS_SOCKS5_PORT}" &
		daemon=$!
		if [ -n "${TS_AUTHKEY:-}" ]; then
			join_tailnet &
		else
			# With state already on the volume the daemon reconnects on its own;
			# `tailscale up` is only needed to consume an auth key.
			log 'TS_AUTHKEY not set: relying on saved node state, not joining'
		fi
		wait "${daemon}" || true
		now=$(date +%s)
		if [ $((now - window_start)) -gt 60 ]; then
			failures=0
			window_start="${now}"
		fi
		failures=$((failures + 1))
		if [ "${failures}" -ge 5 ]; then
			log 'tailscaled exited 5 times in under a minute; giving up on the tailnet'
			return 1
		fi
		log "tailscaled exited, restarting (${failures} in this window)"
		sleep 2
	done
}

run_tailscaled &
log "tailscaled starting (${TS_HOSTNAME}${TS_TAGS:+ as ${TS_TAGS}})"

# --- health -----------------------------------------------------------------
# The greppable line a deploy waits for. `state: running` is not a health
# signal on this platform: PID 1 outliving an OOM-killed child still reports it.
wait_healthy() {
	i=0
	while [ "$i" -lt 150 ]; do
		code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "${HEALTH_URL}" 2>/dev/null || true)
		if [ "${code}" = '401' ] || [ "${code}" = '200' ]; then
			log 'healthy'
			return 0
		fi
		i=$((i + 1))
		sleep 2
	done
	log 'postiz did not answer on 5000 within 300s of boot'
}
wait_healthy &

# --- the app ----------------------------------------------------------------
cd /app
nginx
exec pnpm run pm2
LAUNCH

RUN chmod 755 /ukc-launch.sh && sh -n /ukc-launch.sh
