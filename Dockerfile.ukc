FROM node:22.20-bookworm-slim AS builder
ARG NEXT_PUBLIC_VERSION
ENV NEXT_PUBLIC_VERSION=$NEXT_PUBLIC_VERSION
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ \
    make \
    python3-pip \
    bash \
    nginx \
&& rm -rf /var/lib/apt/lists/*

RUN addgroup --system www \
 && adduser --system --ingroup www --home /www --shell /usr/sbin/nologin www \
 && mkdir -p /www \
 && chown -R www:www /www /var/lib/nginx


RUN npm --no-update-notifier --no-fund --global install pnpm@10.6.1 pm2

WORKDIR /app

COPY . /app
COPY var/docker/nginx.conf /etc/nginx/nginx.conf

RUN pnpm install
RUN NODE_OPTIONS="--max-old-space-size=4096" pnpm run build

CMD ["sh", "-c", "nginx && pnpm run pm2"]

# Unikraft initrd is a flat rootfs with a ~4GiB load ceiling: drop the build
# toolchain and caches after the pnpm build so the image fits.
RUN apt-get purge -y g++ make python3-pip \
 && apt-get autoremove -y \
 && rm -rf /root/.local/share/pnpm /root/.cache /app/.nx /var/lib/apt/lists/*

# node_modules ships as a ROM (read-only image mounted at /app/node_modules);
# the initrd must stay small because it loads into guest RAM.
RUN rm -rf /app/node_modules && mkdir /app/node_modules

# Launcher lives here, not in the build context: editing it must not invalidate
# the COPY layer above. ROM with node_modules attaches as /dev/ukp_rom1.
RUN printf '#!/bin/sh\nset -e\nmount -t erofs -o ro /dev/ukp_rom1 /app/node_modules\ncd /app\nnginx\nexec pnpm run pm2\n' > /ukc-launch.sh && chmod 755 /ukc-launch.sh
